# Bot tokenini @BotFather dan oling
BOT_TOKEN=1234567890:AAH-example-token

# EGA (owner) adminlar — vergul bilan ajratilgan Telegram ID lar.
# Bular hech qachon o'chirilmaydi va FAQAT ular yangi admin qo'sha/o'chira oladi.
# Qo'shimcha adminlar admin panel > 👑 Adminlar bo'limidan qo'shiladi (bazada saqlanadi).
ADMIN_IDS=6496759979,8249917172

# IXTIYORIY: eslatmalar uchun vaqt mintaqasi
TZ=Asia/Tashkent

# NEON (PostgreSQL) MA'LUMOTLAR BAZASI — MUHIM!
# Neon.tech da (yoki Render'dagi Neon integrasiyasi orqali) loyiha yarating va
# "Connection string" (PostgreSQL) ni shu yerga qo'ying.
# Eslatma: Neon loyihasining asosiy va "pooled" (serverless) ulanish satrlarining
# ikkalasi ham ishlaydi; sslmode=require bo'lishi shart.
DATABASE_URL=postgresql://user:password@ep-abc-123-pooler.aws.neon.tech/kino_bot?sslmode=require

# MARKAZIY KINO KANALI — MUHIM!
# Bu kanal kino ombori hisoblanadi: har bir post = bitta kino.
# Postning message_id si kino ID si sifatida ishlatiladi.
# Bot shu kanalda ADMIN bo'lishi shart!
#
# ID ni qanday bilish mumkin:
#   1) @RawDataBot ga kanalning istalgan xabarini forward qiling;
#   2) undagi 'forward_from_chat' -> 'id' qiymatini nusxalang.
MOVIE_CHANNEL_ID=-1001234567890

# ■ WEBHOOK (Render.com free tier uchun) — IXTIYORIY
# Render free rejasida "web" servisdan boshqa tur tekin emas, shuning uchun bot
# webhook rejimida ishga tushadi. Render'da haqiqiy domen RENDER_EXTERNAL_URL
# orqali avtomatik olinadi, shuning uchun WEBHOOK_URL ni qo'lda o'zgartirish
# shart emas. Lokal ishga tushirishda bu blok umuman kerak emas (polling).
WEBHOOK_URL=https://kino-bot-zk4t.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8080
# WEBHOOK_SECRET=telegram_set_webhook_secret_token
